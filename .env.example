# SmartKhet 2.0 Environment Configuration Template
APP_NAME="SmartKhet 2.0"
APP_VERSION="2.0.0"
DEBUG=false

# Database Configuration (Defaults to embedded SQLite with WAL mode)
DATABASE_URL="sqlite:///./smartkhet2.db"

# Server Bindings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Fog & Cloud Simulation Settings
FOG_SYNC_INTERVAL=30
CLOUD_ENDPOINT="http://localhost:8000/cloud"

# Optional: CDS API for ERA5 Automatic Downloads
# CDSAPI_URL="https://cds.climate.copernicus.eu/api/v2"
# CDSAPI_KEY="UID:API-KEY"

# Optional: Kaggle API for Supplementary Weather
# KAGGLE_USERNAME="username"
# KAGGLE_KEY="api-key"

